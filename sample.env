ENV=local
APP_NAME=AppName
PORT=8080
# json selects slog's JSONHandler; anything else gives TextHandler.
LOG_FORMAT=simple
# debug | info | warn | error — an unrecognized value falls back to info.
LOG_LEVEL=debug
# Parsed into env.AppConfig but not wired to anything yet — the template has no
# Sentry integration. Left here as the hook for adding one.
SENTRY_DSN=

PG_PORT=5432
# Host-side value, used by migrations and psql. docker-compose overrides this
# with the `postgres` service name for the containerized service.
PG_HOST=127.0.0.1
PG_USERNAME=postgres
PG_PASSWORD=postgres
PG_DATABASE=master
PG_SCHEMA=public
PG_SSLMODE=disable